# ---------- Server ----------
# Ihre Domain (DNS-A-Eintrag muss auf den Server zeigen) – für das HTTPS-Zertifikat
DOMAIN="dienstplan.ihre-firma.de"
# Datenbank-Passwort für docker compose
POSTGRES_PASSWORD="change-me"

# ---------- Datenbank (PostgreSQL, EU-Hosting empfohlen) ----------
DATABASE_URL="postgresql://sdm:sdm@localhost:5432/sdm?schema=public"

# ---------- Authentifizierung (Auth.js) ----------
# openssl rand -base64 32
AUTH_SECRET="change-me"
# Öffentliche URL der Anwendung (für Links in E-Mails, Auth.js)
APP_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Administratoren müssen 2FA (TOTP) einrichten (true/false)
REQUIRE_ADMIN_2FA=true
# 32-Byte-Schlüssel (hex) zur Verschlüsselung der TOTP-Secrets in der DB: openssl rand -hex 32
DATA_ENCRYPTION_KEY="change-me-64-hex-chars"

# ---------- E-Mail: entweder RESEND oder SMTP ----------
MAIL_FROM="Dienstplanung <dienstplan@ihre-firma.de>"
# Option A: Resend (https://resend.com, Region EU wählen)
RESEND_API_KEY=""
# Option B: SMTP (z. B. Mailserver Ihres Hosters, IONOS, Strato, Mailjet EU …)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------- Web-Push (optional, App-Benachrichtigungen auf dem Smartphone) ----------
# npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ihre-firma.de"

# ---------- Hintergrundjobs ----------
# Schutz für /api/cron (geplante Mitteilungen, Erinnerungen, E-Mail-Wiederholung, Löschfristen)
CRON_SECRET="change-me"
